// Database schema for: Acme "Ops" App
// Description: Every relationship shape and field edge case the schema exporters handle.
// Knack App ID: app_schema_cases

Project knack_app {
  database_type: "Knack"
  Note: "Acme \"Ops\" App"
}

Table object_1 {
  // Accounts
  // Records: 3
  // User Profile Object

  id VARCHAR(50) [pk]  // Knack record ID
  field_3 VARCHAR(50)  // Owner (connection)
  field_10 VARCHAR(50)  // Vendor (connection)

  Note: "Plural: Accounts, Singular: Account"
}

Table object_2 {
  // Accounts
  // Records: 1

  id VARCHAR(50) [pk]  // Knack record ID
  field_20 VARCHAR(50)  // Primary Vendor (connection)
  field_21 VARCHAR(50)  // Account Link (connection)

}

Table object_3 {
  // 3rd Party/Vendor
  // Records: 12

  id VARCHAR(50) [pk]  // Knack record ID
  field_30 VARCHAR(50)  // Partners (connection)

  Note: "Plural: Vendors, Singular: Vendor"
}

// Relationships
Ref: object_1.field_3 < object_2.id // Owner
Ref: object_1.field_10 > object_3.id // Vendor
Ref: object_2.field_20 - object_3.id // Primary Vendor
Ref: object_2.field_21 > object_1.id // Account Link
Ref: object_3.field_30 <> object_1.id // Partners
